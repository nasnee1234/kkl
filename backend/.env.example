PORT=4000

# ไปที่ Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# แล้วก็อปค่าจากไฟล์ JSON ที่ได้มาใส่ตรงนี้ (private key ต้องเก็บ \n ไว้ในเครื่องหมาย " ")
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push (VAPID) — สร้างด้วย: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
